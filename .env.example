DB_NAME=itsectest
DB_USERNAME=itsectest
DB_PASSWORD=itsectest
DB_PORT=5432

REDIS_PORT=6379

# min 32 characters, for example: openssl rand -base64 48
JWT_SECRET=replace-me-with-at-least-32-characters-of-random-secret

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your.address@gmail.com
SMTP_PASSWORD=your-app-password
MAIL_FROM=your.address@gmail.com
# set to false to print the OTP in the app log instead of sending an email
MAIL_DELIVERY_ENABLED=true

MFA_ENABLED=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_LIMIT=10
RATE_LIMIT_DEFAULT_WINDOW=1m
SERVER_PORT=8080
LOG_LEVEL=INFO
