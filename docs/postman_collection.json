                  "description": "SUPER_ADMIN | EDITOR | CONTRIBUTOR | VIEWER"
                },
                {
                  "key": "status",
                  "value": "",
                  "description": "ACTIVE | LOCKED | DISABLED"
                }
              ]
            },
            "description": ""
          }
        },
        {
          "name": "Read user",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/{{userId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "{{userId}}"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "Update user",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/{{userId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "{{userId}}"
              ]
            },
            "description": "Leave out password to keep the current one. Set status to ACTIVE to unlock an account.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullname\": \"Editor Example\",\n  \"email\": \"editor1@example.com\",\n  \"role\": \"CONTRIBUTOR\",\n  \"status\": \"ACTIVE\",\n  \"mfaEnabled\": true\n}"
            }
          }
        },
        {
          "name": "Delete user",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/{{userId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "{{userId}}"
              ]
            },
            "description": "Soft delete. You cannot delete your own account or the last super admin."
          }
        }
      ]
    },
    {
      "name": "Audit log (super admin)",
      "item": [
        {
          "name": "Search audit logs",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/audit-logs?page=0&size=20&action=&status=&actorUsername=&resourceType=&from=&to=",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "audit-logs"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "0",
                  "description": ""
                },
                {
                  "key": "size",
                  "value": "20",
                  "description": ""
                },
                {
                  "key": "action",
                  "value": "",
                  "description": "LOGIN_FAILED, ARTICLE_DELETED, ACCOUNT_LOCKED"
                },
                {
                  "key": "status",
                  "value": "",
                  "description": "SUCCESS | FAILURE"
                },
                {
                  "key": "actorUsername",
                  "value": "",
                  "description": "partial match"
                },
                {
                  "key": "resourceType",
                  "value": "",
                  "description": "ARTICLE | USER | SESSION | ENDPOINT"
                },
                {
                  "key": "from",
                  "value": "",
                  "description": "ISO-8601, for example 2026-09-01T00:00:00Z"
                },
                {
                  "key": "to",
                  "value": "",
                  "description": "ISO-8601"
                }
              ]
            },
            "description": "Filter by action, status, actor, resource type or date range."
          }
        },
        {
          "name": "Read audit log",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/audit-logs/{{auditLogId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "audit-logs",
                "{{auditLogId}}"
              ]
            },
            "description": "Set auditLogId from a search result."
          }
        }
      ]
    },
    {
      "name": "Operations",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8080/actuator/health",
              "host": [
                "localhost"
              ],
              "path": [
                "actuator",
                "health"
              ],
              "protocol": "http",
              "port": "8080"
            },
            "description": "Checks the database and Redis.",
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    }
  ]
}